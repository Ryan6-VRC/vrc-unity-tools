# This repo holds UPM packages only (no Unity project). Keep .meta files tracked —
# Unity generates them on first import and they carry stable asset GUIDs.

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
.vs/
.idea/
.vscode/

# git worktrees for isolated feature work
.worktrees/

# worktree-local headless test editor (generated by tools/setup-test-editor.ps1 -Dest ./TestEditor
# to avoid contending for the shared Atelier/TestEditor when sessions run concurrently)
/TestEditor/

# run output from a worktree-local venue: both run-editmode-tests.ps1 and vrc-patterns/tools/gate.ps1
# write here when pointed at this worktree as their venue root, so the same convention that puts
# TestEditor/ above puts this beside it — and run output must never land in a tracked tooling dir.
/test-output/
